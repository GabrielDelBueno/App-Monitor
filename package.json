{
  "name": "app-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "bootstrap": "node backend/src/bootstrap.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check backend/src/server.js && node --check frontend/app.js && node --check frontend/scanner.js && node --check frontend/connection.js && node --check frontend/pwa.js && node --check frontend/sw.js",
    "demo": "node backend/src/demo.js",
    "test:e2e": "npm run build:static && playwright test",
    "format": "prettier --write backend/src scripts frontend tests playwright.config.js package.json compose.yaml",
    "backup": "node scripts/backup.js",
    "govbr:key": "node scripts/create-subject-key.js",
    "test:deployment": "node tests/deployment/https-smoke.js",
    "test:postgres": "node tests/postgres/run.js",
    "build:static": "node scripts/build-static.js"
  },
  "dependencies": {
    "@zxing/browser": "0.1.5",
    "express": "5.1.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
