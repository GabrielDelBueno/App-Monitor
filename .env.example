# Node 24 carrega este arquivo automaticamente. Copie para .env.
PORT=3333
HOST=0.0.0.0
DATABASE_PATH=./data/app-monitor.sqlite
# Na hospedagem: defina DATABASE_URL no painel privado. Ela tem prioridade sobre DATABASE_PATH.
# DATABASE_URL=
# Primeiro administrador pela web: código aleatório privado, mínimo 32 caracteres.
# SETUP_TOKEN=
# Em HTTPS, use true para cookies seguros.
COOKIE_SECURE=false
# Primeiro administrador: definido somente durante npm run bootstrap.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# Configuração de produção (HTTPS público, somente um proxy confiável).
# PUBLIC_BASE_URL=https://monitor.sua-escola.example
TRUST_PROXY=0

# Habilite somente depois de obter credenciais e homologar no GOV.BR.
GOVBR_ENABLED=false
GOVBR_ENVIRONMENT=homologacao
# GOVBR_CLIENT_ID=
# GOVBR_CLIENT_SECRET_FILE=/caminho/seguro/client-secret.txt
# GOVBR_SUBJECT_KEY_FILE=/caminho/seguro/subject-key.txt
# Alternativas: GOVBR_CLIENT_SECRET e GOVBR_SUBJECT_KEY como variáveis privadas.
# GOVBR_ISSUER=https://sso.staging.acesso.gov.br
# Metadados oficiais, quando discovery não for disponibilizado pelo provedor:
# GOVBR_METADATA_FILE=/caminho/metadata-govbr.json
