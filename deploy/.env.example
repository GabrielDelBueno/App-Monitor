# Copie para deploy/.env, ajuste e não envie credenciais ao GitHub.
APP_DOMAIN=monitor.sua-escola.example
ACME_EMAIL=responsavel@sua-escola.example
GOVBR_ENABLED=false
GOVBR_ENVIRONMENT=homologacao
GOVBR_CLIENT_ID=
# Arquivo local de segredo, lido somente pelo backend via Docker secret.
GOVBR_SECRET_PATH=./secrets/govbr-client-secret.txt
GOVBR_SUBJECT_KEY_PATH=./secrets/govbr-subject-key.txt
